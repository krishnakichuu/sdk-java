<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.krishnakichuu</groupId>
    <artifactId>flowd-sdk-parent</artifactId>
    <version>0.1.0</version>
    <relativePath>../../pom.xml</relativePath>
  </parent>

  <artifactId>flowd-sdk-examples-spring-boot-worker</artifactId>
  <packaging>jar</packaging>

  <!-- Example app, not a library — never publish this to Central even if
       `mvn deploy` is run from the repo root. -->
  <properties>
    <maven.deploy.skip>true</maven.deploy.skip>
  </properties>

  <name>flowd Java SDK - Examples (Spring Boot, Worker)</name>
  <description>
    The consumer half of the Spring Boot shipping example: flowd.task-queue
    is set in application.yml, so flowd-sdk-spring-boot-starter auto-starts
    a FlowdWorker that discovers ShippingActivitiesImpl (an ordinary
    constructor-injected @Component) and classpath-scans for
    ShippingWorkflowImpl. This process only ever consumes tasks off
    "shipping-spring" — it starts nothing itself. Pair with
    examples/spring-boot-client, which only ever produces onto that same
    queue and never runs a worker.
  </description>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>io.github.krishnakichuu</groupId>
      <artifactId>flowd-sdk-spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>repackage</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>

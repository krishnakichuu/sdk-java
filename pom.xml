<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>io.github.krishnakichuu</groupId>
  <artifactId>flowd-sdk-parent</artifactId>
  <version>0.1.0</version>
  <packaging>pom</packaging>

  <name>flowd Java SDK (parent)</name>
  <description>
    Java SDK for flowd (github.com/krishnakichuu/flowd). A standalone,
    multi-module Maven project — a sibling of flowd-engine (the Go server),
    not nested inside it and not part of its build graph.

    Module layout:
      flowd-sdk-core               framework-agnostic core: annotations,
                                    replay engine, client, worker. The only
                                    module every application depends on.
      flowd-sdk-spring-boot-starter  optional auto-configuration for Spring
                                    Boot, depends on core, adds zero
                                    dependencies to it.
      examples/plain-java           runnable examples with no DI framework.
      examples/spring-boot-worker    consumer half of the Spring Boot
                                    example: runs FlowdWorker, never starts
                                    a workflow itself.
      examples/spring-boot-client    producer half: starts workflow runs
                                    via WorkflowClient, runs no worker.

    See ARCHITECTURE.md for the full design rationale.
  </description>

  <url>https://github.com/krishnakichuu/sdk-java</url>

  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/licenses/MIT</url>
    </license>
  </licenses>

  <developers>
    <developer>
      <name>krishna kumar</name>
      <email>krishnashaajith@gmail.com</email>
    </developer>
  </developers>

  <scm>
    <connection>scm:git:git://github.com/krishnakichuu/sdk-java.git</connection>
    <developerConnection>scm:git:ssh://github.com/krishnakichuu/sdk-java.git</developerConnection>
    <url>https://github.com/krishnakichuu/sdk-java</url>
  </scm>

  <modules>
    <module>flowd-sdk-core</module>
    <module>flowd-sdk-spring-boot-starter</module>
    <module>examples/plain-java</module>
    <module>examples/spring-boot-worker</module>
    <module>examples/spring-boot-client</module>
  </modules>

  <properties>
    <maven.compiler.release>21</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <protobuf.version>4.35.1</protobuf.version>
    <grpc.version>1.83.1</grpc.version>
    <junit.version>5.11.3</junit.version>
    <jackson.version>2.18.2</jackson.version>
    <slf4j.version>2.0.16</slf4j.version>
    <spring-boot.version>3.3.5</spring-boot.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.github.krishnakichuu</groupId>
        <artifactId>flowd-sdk-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.krishnakichuu</groupId>
        <artifactId>flowd-sdk-spring-boot-starter</artifactId>
        <version>${project.version}</version>
      </dependency>

      <dependency>
        <groupId>com.google.protobuf</groupId>
        <artifactId>protobuf-java</artifactId>
        <version>${protobuf.version}</version>
      </dependency>
      <dependency>
        <groupId>com.google.protobuf</groupId>
        <artifactId>protobuf-java-util</artifactId>
        <version>${protobuf.version}</version>
      </dependency>
      <dependency>
        <groupId>io.grpc</groupId>
        <artifactId>grpc-protobuf</artifactId>
        <version>${grpc.version}</version>
      </dependency>
      <dependency>
        <groupId>io.grpc</groupId>
        <artifactId>grpc-stub</artifactId>
        <version>${grpc.version}</version>
      </dependency>
      <dependency>
        <groupId>io.grpc</groupId>
        <artifactId>grpc-netty-shaded</artifactId>
        <version>${grpc.version}</version>
      </dependency>
      <dependency>
        <groupId>javax.annotation</groupId>
        <artifactId>javax.annotation-api</artifactId>
        <version>1.3.2</version>
      </dependency>
      <dependency>
        <groupId>com.fasterxml.jackson.core</groupId>
        <artifactId>jackson-databind</artifactId>
        <version>${jackson.version}</version>
      </dependency>
      <dependency>
        <groupId>org.slf4j</groupId>
        <artifactId>slf4j-api</artifactId>
        <version>${slf4j.version}</version>
      </dependency>
      <dependency>
        <groupId>org.junit.jupiter</groupId>
        <artifactId>junit-jupiter</artifactId>
        <version>${junit.version}</version>
        <scope>test</scope>
      </dependency>
      <!-- Deliberately NOT importing spring-boot-dependencies here: this
           dependencyManagement is inherited by flowd-sdk-core too, and core
           must stay uncontaminated by any framework's BOM (see
           ARCHITECTURE.md, "clear separation between SDK core and
           framework-specific integrations"). flowd-sdk-spring-boot-starter
           and each examples/spring-boot-* module imports it locally
           instead. -->
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.13.0</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.5.2</version>
        </plugin>
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>exec-maven-plugin</artifactId>
          <version>3.5.0</version>
        </plugin>
        <plugin>
          <groupId>org.xolstice.maven.plugins</groupId>
          <artifactId>protobuf-maven-plugin</artifactId>
          <version>0.6.1</version>
        </plugin>
        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
          <version>${spring-boot.version}</version>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>

  <!-- Activated explicitly (`mvn -P release deploy`) for publishing
       flowd-sdk-core / flowd-sdk-spring-boot-starter to Maven Central via
       the Central Portal. Never active on a plain `mvn install`, so no
       contributor needs a GPG key or Sonatype token just to build. The
       examples/* modules opt out entirely via maven.deploy.skip. -->
  <profiles>
    <profile>
      <id>release</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-source-plugin</artifactId>
            <version>3.3.1</version>
            <executions>
              <execution>
                <id>attach-sources</id>
                <goals>
                  <goal>jar-no-fork</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <version>3.11.1</version>
            <configuration>
              <!-- Javadoc's strict doclint rejects the many pre-existing
                   comments in this codebase that aren't valid Javadoc HTML
                   (they're plain prose) — disabling it here only relaxes
                   generation for the published -javadoc.jar, changes
                   nothing about source code itself. -->
              <doclint>none</doclint>
              <quiet>true</quiet>
              <failOnError>false</failOnError>
            </configuration>
            <executions>
              <execution>
                <id>attach-javadocs</id>
                <goals>
                  <goal>jar</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
            <version>3.2.7</version>
            <configuration>
              <!-- Non-interactive signing (CI, or local without a TTY
                   attached to gpg-agent) needs loopback pinentry; the
                   passphrase itself comes from MAVEN_GPG_PASSPHRASE. -->
              <gpgArguments>
                <arg>--pinentry-mode</arg>
                <arg>loopback</arg>
              </gpgArguments>
            </configuration>
            <executions>
              <execution>
                <id>sign-artifacts</id>
                <phase>verify</phase>
                <goals>
                  <goal>sign</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <groupId>org.sonatype.central</groupId>
            <artifactId>central-publishing-maven-plugin</artifactId>
            <version>0.11.0</version>
            <extensions>true</extensions>
            <configuration>
              <publishingServerId>central</publishingServerId>
              <!-- false for the first release of each module: lands in
                   Central Portal's "pending" state for one manual check
                   before it goes live and permanent. Flip to true for
                   routine releases afterward if desired. -->
              <autoPublish>false</autoPublish>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
